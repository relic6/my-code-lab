{
  "id": "parallax-tilt-push",
  "category": "transition",
  "source": "components/react/_shared/useParallaxTilt.ts",
  "description": "前后画面以 3D 倾斜推拉错位交替，营造景深穿越感。",
  "defaultDurationInFrames": 42,
  "fps": 30,
  "params": [
    { "key": "tiltMax", "type": "number", "default": 22, "min": 5, "max": 45, "unit": "deg" },
    { "key": "depth", "type": "number", "default": 600, "min": 200, "max": 1200, "unit": "px" },
    { "key": "outSrc", "type": "image", "default": "", "desc": "前一画面图片 URL" },
    { "key": "inSrc", "type": "image", "default": "", "desc": "后一画面图片 URL" }
  ],
  "slots": [
    { "selector": ".outgoing", "desc": "前一画面" },
    { "selector": ".incoming", "desc": "后一画面" }
  ]
}
