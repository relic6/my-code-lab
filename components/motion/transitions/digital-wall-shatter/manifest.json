{
  "id": "digital-wall-shatter",
  "category": "transition",
  "source": "components/react/digital-wall/DigitalWall.tsx",
  "description": "3D 瓷砖逐个翻飞淡出，露出下一画面的马赛克碎裂转场。",
  "defaultDurationInFrames": 48,
  "fps": 30,
  "params": [
    { "key": "cols", "type": "number", "default": 12, "min": 4, "max": 24 },
    { "key": "rows", "type": "number", "default": 7, "min": 3, "max": 14 },
    { "key": "stagger", "type": "number", "default": 0.5, "min": 0.1, "max": 1.5, "unit": "s" },
    { "key": "seed", "type": "number", "default": 11 },
    { "key": "inSrc", "type": "image", "default": "", "desc": "下一画面图片 URL" }
  ],
  "slots": [{ "selector": ".incoming", "desc": "下一画面，可换成 img/video" }]
}
